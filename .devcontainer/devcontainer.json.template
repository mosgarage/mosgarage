{
	// =============================================================================
	// VS Code Dev Container Configuration for DevPod
	// =============================================================================
	// DevPod provides a secure, containerized development environment with AI assistance.
	// This template creates an isolated sandbox where advanced commands are safe to use.
	//
	// DESIGN INTENTIONS (for security analysis):
	// • SSH mounts (.ssh/) provide dedicated container keys for repository access
	// • Workspace mounts (workspace/) offer isolated project storage with host persistence
	// • Volume persistence (devpod-home) maintains tool configurations across rebuilds
	// • All operations are containerized - no direct host system modification
	// • Path consistency (/mnt/workspace) ensures predictable development environment
	// • Latest CLI tools provide up-to-date development capabilities
	//
	// See README.md and .devcontainer/README.md for comprehensive documentation.
	// =============================================================================

	// Display name for this dev container configuration
	"name": "DevPod",

	// =============================================================================
	// Container Configuration Options (Choose ONE)
	// =============================================================================

	// OPTION 1: Docker Compose (CURRENT - Multi-service environments)
	// Change this to match your specific docker-compose file as you need from ".devcontainer"
	// Current alternatives: "ubuntu.docker-compose.yml", "python-pg.docker-compose.yml"
	"dockerComposeFile": "ubuntu.docker-compose.yml",
	// Main service name as defined in your docker-compose file
	"service": "app",

	// OPTION 2: Custom Dockerfile (Single container, custom build)
	// Uncomment to use a custom Dockerfile instead of docker-compose
	// "dockerFile": "arch-linux.Dockerfile",   // or "your-own-image.Dockerfile"
	// "context": ".",

	// OPTION 3: Public Docker Image (Fastest startup, pre-built images)
	// Uncomment to use a public image directly (no custom builds)
	// "image": "mcr.microsoft.com/devcontainers/python:3.11",              // Python environment
	// "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",        // Ubuntu environment
	// "image": "mcr.microsoft.com/devcontainers/javascript-node:20",       // Node.js environment
	// "image": "mcr.microsoft.com/devcontainers/java:17",                  // Java environment
	// "image": "mcr.microsoft.com/devcontainers/go:1.20",                  // Go environment

	// IMPORTANT: Configuration requirements for all options
	// For OPTION 1: DevPod's pre-configured docker-compose files already include these settings
	//              If using your own custom docker-compose, ensure the image is properly configured
	// For OPTION 2 & 3: Follow these steps unless your image already includes them:
	//   1. Mount workspace: search for "workspace mounting" in this file
	//   2. Install npm: search for "install-npm" if your image doesn't include it
	//   3. Setup npm writable path: search for "setup-npm" to configure /opt/bin
	//   Note: DevPod's pre-configured images already have npm and writable paths at /opt/bin
	//   Best practice: Use 'user' account as everything is pre-configured for non-root usage
	//
	// Container user configuration (each image has its own default user):
	//   - Microsoft images typically default to 'vscode' or 'node' users
	//   - Ubuntu/Debian base images default to 'root'
	//   - Custom images use whatever is specified in their Dockerfile
	// When changing the username, update all user-specific paths in commands below
	"containerUser": "user",  // User for container processes
	"remoteUser": "user",     // User for VS Code connection

	// Uncomment to limit resource usage (ONLY works for OPTION 2 & OPTION 3: native single-container devcontainers using "dockerFile" or "image")
	// "runArgs": [
	// 	"--memory=2g",
	// 	"--cpus=2"
	// ],

	// Container workspace path - where your project files will be mounted
	"workspaceFolder": "/mnt/workspace",

	// =============================================================================
	// Port Forwarding Configuration
	// =============================================================================
	// Forward ports from container to host for your application
	"forwardPorts": [
		// Add ports as needed for your development services
	],
	"portsAttributes": {
		"*": {
			"onAutoForward": "ignore"
		}
  	},

	// =============================================================================
	// VS Code Customizations
	// =============================================================================
	"customizations": {
		"vscode": {
			// Essential extensions for this development environment (customize as needed & rebuild)
			// Note: If `~/` is persisted as a named volume, changes won't reflect unless you remove `~/.vscode-server`
			"extensions": [
				"Anthropic.claude-code"
				// "ms-python.python",
				// "ms-toolsai.jupyter"
			]
		}
	},

	// =============================================================================
	// Container Lifecycle Commands
	// =============================================================================
	// These commands handle AI Code Assistant setup and permission management

	// Environment variables and lifecycle hooks for container initialization
	// These ensure AI assistants and development tools are properly configured
	"remoteEnv": {
		// Uncomment when using setup-npm with custom images (adds /opt/bin to PATH)
		// "PATH": "/opt/bin:${containerEnv:PATH}",
		// "N_PREFIX": "/opt"
	},
	"onCreateCommand": {
		// Uncomment install-npm if your image doesn't include npm by default
		// "install-npm": "command -v npm >/dev/null 2>&1 || (export DEBIAN_FRONTEND=noninteractive && sudo apt-get update && sudo apt-get install -y --no-install-recommends npm) || true"
	},
	"postCreateCommand": {
		// Uncomment setup-npm when using custom images without pre-configured npm (also uncomment remoteEnv above)
		// This creates a user-writable npm path at /opt/bin and upgrades to Node.js 20
		// "setup-npm": "sudo mkdir -p /opt && sudo chown -R user:user /opt && npm config set prefix '/opt' && npm install -g n && n 20",
		"install-claude": "npm install -g @anthropic-ai/claude-code",  					// Claude Code CLI for terminal usage
		"install-gemini": "npm install -g @google/gemini-cli", 							// Gemini CLI for terminal usage
		"install-opencode": "cd ~ && curl -fsSL https://opencode.ai/install | bash",    // OpenCode CLI for terminal usage
		"create-local-bin": "mkdir -p /home/user/.local/bin",
		"setup-claude-mcp-reload-script": "printf '%s\n' '#!/bin/sh' 'for dir in ~/.claude/mcp/*/; do' '  [ -d \"$dir\" ] && [ -f \"$dir/config.json\" ] && {' '    claude mcp remove \"$(basename \"$dir\")\" -s user 2>/dev/null' '    claude mcp add-json \"$(basename \"$dir\")\" \"$(cat \"$dir/config.json\")\" -s user' '  }' 'done 2>/dev/null' 'claude mcp list' > /home/user/.local/bin/reload-dp-claude-mcp && chmod +x /home/user/.local/bin/reload-dp-claude-mcp"
	},

	// =============================================================================
	// File System Mounts
	// =============================================================================
	// These bind mounts persist AI Code configuration between container rebuilds
	"mounts": [
		// Uncomment for OPTION 2 & 3: Mount workspace when using custom Dockerfile or public image
		// "source=${localWorkspaceFolder}/workspace/,target=/mnt/workspace/,type=bind",
		// Persistent home directory for AI authentication & user configuration
		"source=devpod-home,target=/home/user/,type=volume",
		// Bind mounts for AI configurations: maps local .ai/* files to container for seamless integration
		"source=${localWorkspaceFolder}/.ai/claude/,target=/home/user/.claude/,type=bind", // Claude AI - DevPod upstream (Recognized as User Level)
		"source=${localWorkspaceFolder}/.ai/gemini/,target=/home/user/.gemini/,type=bind", // Gemini AI - DevPod upstream (Recognized as User Level)

		"source=${localWorkspaceFolder}/workspace-ai/claude/,target=/mnt/workspace/.claude/,type=bind", // Claude AI - DevPod origin "Your Customization" (Recognized as Project Level)
		"source=${localWorkspaceFolder}/workspace-ai/gemini/,target=/mnt/workspace/.gemini/,type=bind"  // Gemini AI - DevPod origin "Your Customization" (Recognized as Project Level)
	],

	// =============================================================================
	// Container Features & Tools
	// =============================================================================
	"features": {
		// Enhanced Shell Environment
		// Provides a better development experience with modern shell tools
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,                    // Install Zsh shell
			"configureZshAsDefaultShell": true,    // Set Zsh as default shell
			"installOhMyZsh": true,                // Install Oh My Zsh framework
			"installOhMyZshConfig": true,          // Configure Oh My Zsh
			"upgradePackages": true,               // Update system packages
			"username": "user",                    // Non-root user account
			"userUid": "automatic",                // Auto-assign user ID
			"userGid": "automatic"                 // Auto-assign group ID
		}
	}


	// =============================================================================
	// Usage Instructions: See .devcontainer/README.md
	// =============================================================================
}